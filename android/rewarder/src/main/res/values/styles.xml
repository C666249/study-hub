<?xml version="1.0" encoding="utf-8"?>
<resources>
 <style name="RewardTheme" parent="android:style/Theme.Material.Light.NoActionBar">
   <item name="android:fontFamily">sans</item>
   <item name="android:colorAccent">#E3C28B</item>
   <item name="android:windowLightStatusBar">false</item>
   <item name="android:statusBarColor">#101113</item>
   <item name="android:navigationBarColor">#101113</item>
   <item name="android:windowLightNavigationBar">false</item>
   <item name="android:windowActionModeOverlay">true</item>
   <item name="android:windowBackground">#101113</item>
 </style>
 <style name="RewardSheet" parent="android:style/Theme.Material.Light.NoActionBar">
   <item name="android:windowIsFloating">true</item>
   <item name="android:windowBackground">@android:color/transparent</item>
   <item name="android:windowDimAmount">0.65</item>
   <item name="android:backgroundDimEnabled">true</item>
   <item name="android:colorAccent">#E3C28B</item>
 </style>
</resources>